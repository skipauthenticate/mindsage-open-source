# Server Configuration
PORT=3003

# Frontend API URL (for development)
VITE_API_URL=http://localhost:3003

# Note: ChatGPT credentials are configured via the UI
# and stored in data/ directory, not in .env

# MCP Vector Store Configuration
# Host and port where the mcp-vector-store HTTP server is running
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=8085
# Optional authenticated remote MCP mode. Tokens must be 32+ characters.
# MCP_VECTOR_STORE_PUBLIC=false
# VECTOR_STORE_API_KEY=your-strong-vector-store-token
# MCP_VECTOR_STORE_API_KEY=your-strong-vector-store-token

# LLM Configuration (set one or more, or configure via UI)
# ANTHROPIC_API_KEY=your-key
# OPENAI_API_KEY=your-key
# GROQ_API_KEY=your-key

# PII Protection
# Options: minimal, default, strict, or comma-separated entity list
# PII_ENTITIES=strict

# LPRAG (Local Differential Privacy)
# LPRAG_MODE=hybrid          # disabled | pure | hybrid
# LPRAG_PRESET=default       # minimal | default | aggressive
